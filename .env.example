# Copy to .env and adjust. Every value has a default in docker-compose.yml,
# so the stack also starts without a .env file. Never commit the real .env.

# PostgreSQL credentials (local demo only - use real secrets elsewhere)
POSTGRES_DB=apiflow
POSTGRES_USER=apiflow
POSTGRES_PASSWORD=change-me

# Host port of the dashboard
FRONTEND_PORT=4200

# Spans at or above this duration are flagged as slow (yellow)
FLOW_SLOW_THRESHOLD=250ms

# Retention of demo traces
FLOW_RETENTION_MAX_TRACES=1000
FLOW_RETENTION_MAX_AGE=24h
